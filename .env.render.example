# 汇盈探店：Render 单实例部署环境变量模板（全部为占位符，不含真实密钥）。
# 用途：本地验证 render 形态 / CLI (render blueprint) 首次填值对照；线上平台注入环境变量，不需要上传 .env。
# 逐命令部署操作、免费库 30 天到期、持久磁盘与重启说明见 docs/RENDER.md。
# 与根 .env 的关系：这只是模板副本；本机开发请继续使用根目录 .env（不提交 Git）。

# ---------- Runtime（Render 注入 PORT；HOST 必须 0.0.0.0） ----------
NODE_ENV=production
HOST=0.0.0.0
# PORT=10000            # Render 平台自动注入并转发公网流量，勿手工设置
NODE_VERSION=24
# 部署目标：生产 + 本地磁盘存储的唯一合法 opt-in（缺省时生产仍禁止 local）
DEPLOYMENT_TARGET=render
# Render 平台自动注入服务公网 URL（https://<service>.onrender.com）；本地验证时可手工指向
# 你的真实 Render 服务地址。四个公开 Origin（PUBLIC_API_ORIGIN/MINIAPP_API_BASE_URL/
# ADMIN_ORIGIN/WEB_ORIGIN）由服务端从它派生（https 同源），无需逐个配置。
RENDER_EXTERNAL_URL=https://your-service.onrender.com

# ---------- 文件存储（Render 持久磁盘 1GB 挂载 /var/data） ----------
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=/var/data/storage

# ---------- PostgreSQL（Render fromDatabase 自动注入 connectionString；此处仅本地验证用占位） ----------
DATABASE_URL=postgresql://user:password@host/junde

# ---------- Secrets（sync:false：只在 Render 控制台/CLI 填真实值，绝不写进 Git） ----------
AUTH_TOKEN_HMAC_KEY=openssl-rand-hex-32
PHONE_ENCRYPTION_KEY_BASE64=openssl-rand-base64-32
# 腾讯位置服务浏览器 Key（打卡定位公开 Key；运行时提供）
TENCENT_MAP_KEY=your-tencent-map-key

# ---------- 认证形态（本地先跑通形态：无 SMS/CAPTCHA，自助注册/找回休眠） ----------
AUTH_SELF_SERVICE=disabled
AUTH_PROVIDER_MODE=tencent
AUTH_HASH_MAX_CONCURRENCY=1
AUTH_HASH_MAX_QUEUE=8

# ---------- 小票 OCR（关闭：纯手动填写，小票原图上传不受影响） ----------
OCR_PROVIDER=none

# ---------- 数据库连接池（512MB 单实例收敛） ----------
DATABASE_POOL_MAX=4

# ---------- 以下键在 Render 形态必须留空 ----------
CAPTCHA_APP_ID=
CAPTCHA_APP_SECRET_KEY=
CAPTCHA_API_SECRET_ID=
CAPTCHA_API_SECRET_KEY=
SMS_SECRET_ID=
SMS_SECRET_KEY=
SMS_SDK_APP_ID=
SMS_SIGN_NAME=
SMS_TEMPLATE_IDS=
OCR_SERVICE_URL=
OCR_SECRET_ID=
OCR_SECRET_KEY=
