# 汇盈探店：本地先跑通形态模板（无云依赖：本地磁盘存储 + 关闭 OCR + 关闭自助注册）。
# 用法：cp .env.local.example .env（根目录 .env 即当前活跃环境），填好密钥后重启 npm run dev:api / start:worker。
# 语义：STORAGE_PROVIDER=local 把小票/证据/录音/导出文件全部落到本机磁盘（.local-storage/，
# 已被 .gitignore 排除，绝不入库入 Git）；数据库仍是本机 PostgreSQL，不使用 SQLite。
# 与云上形态的切换：见 README「本地存储 / 云上切换」——只需换 STORAGE_PROVIDER 与 COS_* 键并重启，
# 业务页面与 worker 不用改任何代码。注意：本地已产生的文件不会自动迁移上云，环境之间数据各自独立。
#
# 生产环境（NODE_ENV=production）会直接拒绝 STORAGE_PROVIDER=local 并强制 COS 完整校验。

# ---------- Runtime ----------
NODE_ENV=development
HOST=0.0.0.0
# 本机直跑 3000；PUBLIC_API_ORIGIN 必须与实际端口一致（签名直传/预览/下载 URL 都以它为来源）。
PORT=3000
LOG_LEVEL=info
# 本机无反向代理时留空或删除；仅当显式走本机代理时才填。
TRUST_PROXY=

# ---------- Public origins（本地回环；需要手机/局域网访问时改成 http://<局域网IP>:3000） ----------
PUBLIC_API_ORIGIN=http://127.0.0.1:3000
MINIAPP_API_BASE_URL=http://127.0.0.1:3000
ADMIN_ORIGIN=http://127.0.0.1:5173
# 腾讯位置服务浏览器公开 Key（打卡定位用；本地也可复用开发 Key）。
TENCENT_MAP_KEY=

# ---------- 文件存储（本地磁盘形态） ----------
# local：证据/小票/录音/导出落本机磁盘；cos：私有腾讯云 COS（生产唯一允许形态）。
STORAGE_PROVIDER=local
# 存储根目录：API 与 worker 必须同一目录；相对路径以仓库根（npm 脚本运行目录）解析。
LOCAL_STORAGE_DIR=.local-storage
# 签名授权有效期（秒）：上传直传与预览/下载。
LOCAL_UPLOAD_TTL_SECONDS=300
LOCAL_PREVIEW_TTL_SECONDS=300

# ---------- PostgreSQL 17（本地仍用 PostgreSQL，不用 SQLite） ----------
DATABASE_URL=postgresql://junde:change-me@127.0.0.1:5432/junde
DATABASE_POOL_MAX=10
DATABASE_POOL_ACQUIRE_TIMEOUT_MS=2000
MAX_ASSIGNMENTS_PER_CAMPAIGN=500

# ---------- Authentication keys ----------
# AUTH_TOKEN_HMAC_KEY：32+ 字符随机串（本地形态同时派生磁盘对象签名密钥，与生产不得同值）。
# PHONE_ENCRYPTION_KEY_BASE64：32 字节随机密钥的 base64。
AUTH_TOKEN_HMAC_KEY=
PHONE_ENCRYPTION_KEY_BASE64=
AUTH_HASH_MAX_CONCURRENCY=2
AUTH_HASH_MAX_QUEUE=8

# ---------- 自助注册/找回开关（本地形态：无 SMS/CAPTCHA，必须 disabled） ----------
# disabled=自助注册/找回休眠（小程序相应入口隐藏），管理员用既有账号在后台手工建号；
# 供应商保持 tencent 形态（密钥留空时相应能力业务化不可用，登录不受影响）。
AUTH_SELF_SERVICE=disabled
AUTH_PROVIDER_MODE=tencent
# 以下 CAPTCHA_*/SMS_* 全部留空（disabled 形态要求；生产 enabled 时才必填）。
CAPTCHA_APP_ID=
CAPTCHA_APP_SECRET_KEY=
CAPTCHA_API_SECRET_ID=
CAPTCHA_API_SECRET_KEY=
CAPTCHA_REGION=
CAPTCHA_TIMEOUT_MS=8000
SMS_SECRET_ID=
SMS_SECRET_KEY=
SMS_SDK_APP_ID=
SMS_SIGN_NAME=
SMS_TEMPLATE_IDS=
SMS_TIMEOUT_MS=8000

# ---------- Private COS（本地形态全部留空；切云时按 .env.example 填写三桶+renewing 凭证） ----------
COS_REGION=ap-shanghai
COS_EVIDENCE_BUCKET=
COS_EXPORT_BUCKET=
COS_BACKUP_BUCKET=
COS_ROLE_ARN=
COS_ASSUME_ROLE_SECRET_ID=
COS_ASSUME_ROLE_SECRET_KEY=
COS_STS_DURATION_SECONDS=3600
COS_STS_REFRESH_BEFORE_SECONDS=300
COS_STS_TIMEOUT_MS=8000
COS_UPLOAD_TTL_SECONDS=300
COS_PREVIEW_TTL_SECONDS=300

# ---------- 小票 OCR（本地形态关闭：纯手动填写，消费小票原图仍必须上传） ----------
# none=关闭（OCR_SERVICE_URL/OCR_SECRET_* 必须全部留空）；切云后可改 tencent/paddle。
OCR_PROVIDER=none
OCR_SECRET_ID=
OCR_SECRET_KEY=
OCR_REGION=ap-shanghai
OCR_SERVICE_URL=
OCR_REQUEST_TIMEOUT_MS=90000
OCR_MODEL_VERSION=
OCR_PARSER_VERSION=receipt-parser-v1
OCR_JOB_LEASE_SECONDS=300
OCR_WORKER_POLL_INTERVAL_MS=30000
OCR_WORKER_MAX_CONCURRENCY=1
OCR_WORKER_CLAIM_LIMIT=4
OCR_JOB_MAX_ATTEMPTS=3
OCR_MAX_QUEUED_JOBS=500

# ---------- Retention / backup ----------
# 本地形态没有备份上传目标（ops/backup-database.mjs 会拒绝执行）；BACKUP_PREFIX 仅供云形态。
RETENTION_POLICY_VERSION=phase1-v1
OBJECT_RECONCILIATION_SAMPLE_SIZE=100
BACKUP_PREFIX=postgres
