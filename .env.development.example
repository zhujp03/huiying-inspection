# 汇盈探店：开发环境（开发版）配置模板 —— 不是本地测试版，也不是生产版。
# 用法：cp .env.development.example .env（根目录 .env 即当前活跃环境）。
# 若想先在本机无云依赖跑通（本地磁盘文件 + 关闭 OCR/自助注册），改用 cp .env.local.example .env；
# 切换说明见 README「本地存储 / 云上切换」。
# 语义：NODE_ENV=development + AUTH_PROVIDER_MODE=tencent（真实供应商代码路径）。
#   与"本地测试版"的区别：不使用 sandbox、不使用 SMS_SANDBOX_*、不以 127.0.0.1 为
#   常态 Origin；缺省的真实供应商密钥在开发环境优雅降级（登录/验证码/短信/OCR
#   显示业务化不可用），只有 production 才失败关闭。
# 与生产的区别：域名用开发子域（dev-api./dev-admin.），数据库/COS/短信/验证码全部
#   使用独立的"开发实例"，禁止与生产共用（见 BACKEND_DESIGN 3.1）。

# ---------- Runtime ----------
NODE_ENV=development
HOST=0.0.0.0
# 容器部署必须 8787（与 Compose healthcheck 一致）；本机直跑可临时改 3000。
PORT=8787
LOG_LEVEL=info
TRUST_PROXY=127.0.0.1/32

# ---------- Public origins（开发子域：替换为你的备案域名；DNS 生效前本机联调可
# 临时改回 http://127.0.0.1:3000，NODE_ENV=development 时生成器允许） ----------
PUBLIC_API_ORIGIN=https://dev-api.example.cn
MINIAPP_API_BASE_URL=https://dev-api.example.cn
ADMIN_ORIGIN=https://dev-admin.example.cn
# 探员端 H5 站点（Caddy 站点块 + COS 桶 CORS 白名单共用）；换域名只改此键。
WEB_ORIGIN=https://dev-web.example.cn
TENCENT_MAP_KEY=

# ---------- PostgreSQL 17 ----------
# 开发服务器上的开发库（独立于生产）。本机未起开发服务器前可暂用本地库。
# 本机 dev:up 容器（scripts/dev-up.mjs 拉起的 junde-pg17）固定映射 5433，避免与本机其他 PG 实例冲突。
DATABASE_URL=postgresql://junde:change-me@127.0.0.1:5433/junde_dev
# DB_PORT：dev:up 探测数据库就绪用的端口，默认 5433；仅当自定义容器端口时才需要导出该变量。
# DB_PORT=5433
DATABASE_POOL_MAX=10
DATABASE_POOL_ACQUIRE_TIMEOUT_MS=2000
MAX_ASSIGNMENTS_PER_CAMPAIGN=500

# ---------- Authentication keys ----------
# 开发环境也请使用真实随机值（与生产不得同值）：
#   AUTH_TOKEN_HMAC_KEY：openssl rand -hex 32
#   PHONE_ENCRYPTION_KEY_BASE64：openssl rand -base64 32
AUTH_TOKEN_HMAC_KEY=
PHONE_ENCRYPTION_KEY_BASE64=
AUTH_HASH_MAX_CONCURRENCY=2
AUTH_HASH_MAX_QUEUE=8

# ---------- Tencent CAPTCHA（开发实例；四类密钥职责分离，禁止复用同一值） ----------
# 开发环境密钥缺省时：/api/public/client-config 不返回 captchaAppId，小程序登录页
# 验证码区域业务化不可用并允许重试；不会假装成功。
AUTH_PROVIDER_MODE=tencent
# 开发环境保持自助注册/找回可用（缺密钥时优雅降级）；可改为 disabled 验证休眠形态
AUTH_SELF_SERVICE=enabled
CAPTCHA_APP_ID=
CAPTCHA_APP_SECRET_KEY=
CAPTCHA_API_SECRET_ID=
CAPTCHA_API_SECRET_KEY=
CAPTCHA_REGION=
CAPTCHA_TIMEOUT_MS=8000

# ---------- Tencent SMS（开发实例：独立签名/模板或白名单通道，禁止用生产模板） ----------
SMS_SECRET_ID=
SMS_SECRET_KEY=
SMS_SDK_APP_ID=
SMS_SIGN_NAME=
# 留空＝开发环境短信降级不可用；填法：{"registration":"模板ID","passwordReset":"模板ID"}
SMS_TEMPLATE_IDS=
SMS_TIMEOUT_MS=8000

# ---------- Private COS（开发三桶，独立于生产；renewing 为唯一长期运行模式） ----------
COS_REGION=ap-shanghai
COS_EVIDENCE_BUCKET=
COS_EXPORT_BUCKET=
COS_BACKUP_BUCKET=
COS_ROLE_ARN=
COS_ASSUME_ROLE_SECRET_ID=
COS_ASSUME_ROLE_SECRET_KEY=
COS_STS_DURATION_SECONDS=3600
COS_STS_REFRESH_BEFORE_SECONDS=300
COS_STS_TIMEOUT_MS=8000
COS_UPLOAD_TTL_SECONDS=300
COS_PREVIEW_TTL_SECONDS=300

# ---------- Private PaddleOCR（私网地址；开发环境用 sidecar 形态，dev:up 会拉起 OCR 容器） ----------
OCR_PROVIDER=paddle
OCR_SERVICE_URL=http://ocr:8080
OCR_REQUEST_TIMEOUT_MS=90000
OCR_MODEL_VERSION=PP-OCRv6_small
OCR_PARSER_VERSION=receipt-parser-v1
OCR_JOB_LEASE_SECONDS=300
OCR_WORKER_POLL_INTERVAL_MS=30000
OCR_WORKER_MAX_CONCURRENCY=1
OCR_WORKER_CLAIM_LIMIT=4
OCR_JOB_MAX_ATTEMPTS=3
OCR_MAX_QUEUED_JOBS=500

# ---------- Retention / backup ----------
RETENTION_POLICY_VERSION=phase1-v1
OBJECT_RECONCILIATION_SAMPLE_SIZE=100
BACKUP_PREFIX=postgres_dev

# ---------- 仅部署/运维脚本使用 ----------
# ENV_FILE=../../.env.development   # 本文件作为 --env-file 供 Compose 插值时需设置
# BACKUP_EXECUTION_CONFIRM=yes
# CADDY_EMAIL=                       # Caddy ACME 证书申请邮箱（开发子域也需可收信邮箱）
CADDY_EMAIL=
