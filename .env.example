# 汇盈探店：唯一部署配置说明（无密钥）
# 用法：cp .env.example .env，然后只在本机填写 .env（不提交 Git、不发给任何人）。
# 所有代码（API/Worker/OCR/Admin/小程序/部署脚本）统一从本文件契约读取。
#
# 变量来源：腾讯云控制台 / 微信公众平台 / 域名服务商。Secret 只在本机、CI Secret
# 或云控制台维护；生产缺少任何强制类别时启动失败关闭（不输出值，只输出变量名）。
# 自助注册/找回由 AUTH_SELF_SERVICE 两态控制：enabled 时以下 CAPTCHA_*/SMS_* 必填；
# disabled 时这些键必须全部留空（自助接口返回 503）；生产必须显式声明该开关。
# 小票 OCR 由 OCR_PROVIDER 三态控制（none=关闭/tencent=腾讯云 OCR/paddle=自托管 sidecar）：
# 默认 none（纯手动填写，2C2G 单机可部署）；生产必须显式声明；三种形态的填法见下方 OCR 段。

# ---------- Runtime ----------
NODE_ENV=production
HOST=0.0.0.0
PORT=8787
LOG_LEVEL=info
# 可信反向代理 CIDR（逗号分隔）。只有来自这些地址的 X-Forwarded-For 才被信任。
TRUST_PROXY=127.0.0.1/32
# 部署目标：留空 = 既有形态；render = Render 单实例（生产+本地磁盘存储的唯一合法 opt-in，
# API 同域托管 H5(/) 与 Admin(/admin/)；见 render.yaml 与 docs/RENDER.md）。
# DEPLOYMENT_TARGET=
# RENDER_EXTERNAL_URL=   # Render 平台注入的服务公网 URL；render 目标下用于派生四个公开 Origin 默认值
# WEB_ORIGIN=            # 探员端 H5 站点（render 目标下与 API 同源；生产必须 HTTPS）

# ---------- Public origins（生产必须 HTTPS 公网来源，禁止 localhost/占位值） ----------
# 对外 API Origin；Admin 同域部署时用相对 /api，无需额外配置。
PUBLIC_API_ORIGIN=https://api.example.cn
# 小程序 API Origin：由 release:prepare 写入小程序包的唯一公开值。
MINIAPP_API_BASE_URL=https://api.example.cn
# Admin Cookie/CORS 来源。
ADMIN_ORIGIN=https://admin.example.cn
# 探员端 H5 站点（Caddy 站点块 + COS 桶 CORS 白名单共用）；换域名只改此键。
WEB_ORIGIN=https://web.example.cn
# 腾讯位置服务浏览器公开 Key（仅允许正式后台域名）；由公开配置接口下发。
TENCENT_MAP_KEY=

# ---------- PostgreSQL 17 ----------
# 低成本单机形态（同机自建 PG17，由生产 compose 编排）：
#   DATABASE_URL       容器内服务（api/worker）使用，主机名固定 postgres:5432；
#   DATABASE_HOST_URL  宿主机脚本（preflight/deploy/backup/migrate）使用，指向 127.0.0.1:5432；
#   POSTGRES_USER/PASSWORD/DB 注入 compose 的 postgres 服务（首次启动初始化数据库）。
# 两条路径都必须实测连通（npm run preflight:production 会校验）。
# 如改用外部托管 PG：DATABASE_URL 直接指向托管地址，并删除 compose 中的 postgres 服务块。
POSTGRES_USER=junde
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=junde
DATABASE_URL=postgresql://junde:change-me-strong-password@postgres:5432/junde
DATABASE_HOST_URL=postgresql://junde:change-me-strong-password@127.0.0.1:5432/junde
DATABASE_POOL_MAX=10
DATABASE_POOL_ACQUIRE_TIMEOUT_MS=2000
MAX_ASSIGNMENTS_PER_CAMPAIGN=500
# API 请求/处理器超时与附件校验并发（可选，留空即用代码默认值；见 apps/api/src/config.js）。
API_REQUEST_TIMEOUT_MS=12000
API_HANDLER_TIMEOUT_MS=10000
# 证据附件校验背压：同时校验的附件数（1-8）与排队上限（0-100）。
ATTACHMENT_VERIFY_MAX_CONCURRENCY=2
ATTACHMENT_VERIFY_QUEUE_MAX=8

# ---------- Authentication keys ----------
# AUTH_TOKEN_HMAC_KEY: 32+ 字符随机串（会话/验证码/盲索引 HMAC）。
# PHONE_ENCRYPTION_KEY_BASE64: 32 字节随机密钥的 base64。
AUTH_TOKEN_HMAC_KEY=
PHONE_ENCRYPTION_KEY_BASE64=
AUTH_HASH_MAX_CONCURRENCY=2
AUTH_HASH_MAX_QUEUE=8

# ---------- 自助注册/找回开关 ----------
# enabled=提供自助注册/找回（以下 CAPTCHA_*/SMS_* 键必填）；
# disabled=功能休眠（以下键必须全部留空，自助接口返回 503）；生产环境必须显式声明本开关。
AUTH_SELF_SERVICE=disabled

# ---------- Tencent CAPTCHA（四类密钥职责分离，禁止复用同一值；仅 AUTH_SELF_SERVICE=enabled 时必填；disabled 时必须留空） ----------
# CAPTCHA_APP_ID: 公开应用 ID（十进制正整数，可进入小程序包）。
# CAPTCHA_APP_SECRET_KEY: 验证码 AppSecretKey（仅服务端，票据校验请求体）。
# CAPTCHA_API_SECRET_ID/KEY: 腾讯云 API 凭据（仅服务端，TC3 签名）。
AUTH_PROVIDER_MODE=tencent
CAPTCHA_APP_ID=
CAPTCHA_APP_SECRET_KEY=
CAPTCHA_API_SECRET_ID=
CAPTCHA_API_SECRET_KEY=
CAPTCHA_REGION=
CAPTCHA_TIMEOUT_MS=8000

# ---------- Tencent SMS（注册与找回密码两个模板都必须审核通过；仅 AUTH_SELF_SERVICE=enabled 时必填；disabled 时必须留空） ----------
SMS_SECRET_ID=
SMS_SECRET_KEY=
SMS_SDK_APP_ID=
SMS_SIGN_NAME=
# enabled 时形如 {"registration":"1XXXXXXXX","passwordReset":"1YYYYYYYY"}，两模板须审核通过
SMS_TEMPLATE_IDS=
SMS_TIMEOUT_MS=8000
# 以下仅非生产 sandbox 模式使用
# AUTH_PROVIDER_MODE=sandbox
# SMS_SANDBOX_WHITELIST_PHONES=+8613800000000
# SMS_SANDBOX_FIXED_CODE=123456

# ---------- Private COS（renewing 为唯一长期运行模式；三桶必须互不相同） ----------
# 文件存储形态 STORAGE_PROVIDER=cos（默认）| local（本地磁盘，仅 development/test；生产启动直接拒绝，
# 本地形态模板见 .env.local.example，切换说明见 README「本地存储 / 云上切换」）。
COS_REGION=ap-shanghai
COS_EVIDENCE_BUCKET=
COS_EXPORT_BUCKET=
COS_BACKUP_BUCKET=
COS_ROLE_ARN=qcs::cam::uin/10001:roleName/junde-cos-staging
COS_ASSUME_ROLE_SECRET_ID=
COS_ASSUME_ROLE_SECRET_KEY=
COS_STS_DURATION_SECONDS=3600
COS_STS_REFRESH_BEFORE_SECONDS=300
COS_STS_TIMEOUT_MS=8000
COS_UPLOAD_TTL_SECONDS=300
COS_PREVIEW_TTL_SECONDS=300
# 一次性静态 STS 仅测试/运维使用，production 禁止配置（COS_STS_*）。

# ---------- 小票 OCR 功能开关（三态，默认关闭） ----------
# none    = 纯手动填写形态：无需任何 OCR 资源（2C2G 单机可部署）。
#           OCR_SERVICE_URL 与 OCR_SECRET_ID/OCR_SECRET_KEY 必须全部留空。
# tencent = 腾讯云通用印刷体识别 GeneralBasicOCR（按量付费）：
#           填 OCR_SECRET_ID/OCR_SECRET_KEY（仅可调用 OCR 接口的最小权限 CAM 子账号）；
#           OCR_REGION 默认 ap-shanghai（与 COS 证据桶同地域）；OCR_SERVICE_URL 必须留空。
#           已知限制：接口 base64 上限约 7MB，超过 10MiB 上限内的大图会失败（手工填写兜底）。
# paddle  = 自托管 PaddleOCR sidecar（逃生舱，--profile ocr 启用，需 4C8G+）：
#           填 OCR_SERVICE_URL（私网地址，禁止 localhost 公网配置）；OCR_SECRET_* 必须留空。
# 生产环境必须显式声明本开关；切换形态后 docker compose up -d 即可，小程序无需重新发版。
OCR_PROVIDER=none
OCR_SECRET_ID=
OCR_SECRET_KEY=
OCR_REGION=ap-shanghai
OCR_SERVICE_URL=
OCR_REQUEST_TIMEOUT_MS=90000
# 模型版本默认值按 provider 区分（paddle→PP-OCRv6_small；tencent→tencent-general-basic），一般留空
OCR_MODEL_VERSION=
OCR_PARSER_VERSION=receipt-parser-v1
OCR_JOB_LEASE_SECONDS=300
OCR_WORKER_POLL_INTERVAL_MS=30000
OCR_WORKER_MAX_CONCURRENCY=1
OCR_WORKER_CLAIM_LIMIT=4
OCR_JOB_MAX_ATTEMPTS=3
OCR_MAX_QUEUED_JOBS=500

# ---------- Retention / backup ----------
RETENTION_POLICY_VERSION=phase1-v1
OBJECT_RECONCILIATION_SAMPLE_SIZE=100
BACKUP_PREFIX=postgres

# ---------- 仅部署/运维脚本使用（不进运行时 Schema 白名单之外的业务逻辑） ----------
# ENV_FILE=/absolute/path/to/.env   # 部署脚本可显式指定 .env 位置
# BACKUP_EXECUTION_CONFIRM=yes      # 执行备份前必须显式确认
# Caddy ACME 证书申请邮箱（compose 注入 Caddy 容器；生产预检要求非空）
CADDY_EMAIL=
