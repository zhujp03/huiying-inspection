<view wx:if="{{loading}}" class="page muted">正在打开临时编辑…</view><view wx:elif="{{error}}" class="page"><view class="card">{{error}}</view></view><view wx:elif="{{question}}" class="page page--safe"><view class="card issue-question"><text class="eyebrow">第 {{question.number}} 题</text><text>{{question.text}}</text></view><view wx:if="{{target === 'scored'}}" class="card"><text class="title">改为得分？</text><text class="muted">确认后将清除当前问题说明和证据；取消不会改变原答案。</text></view><block wx:else><view class="card"><label class="field"><text class="field__label">问题说明 <text class="required">必填</text></text><textarea class="textarea" value="{{remark}}" bindinput="remark" adjust-position="{{true}}" cursor-spacing="40" placeholder="请描述现场看到的问题，可使用系统输入法语音输入" /></label></view><view class="card" data-evidence-photos="optional"><text class="field__label">问题照片（选填）</text><view class="evidence-list"><view wx:for="{{images}}" wx:key="id" class="evidence-ready"><text>{{item.progressLabel || (item.status === 'active' ? '已保存照片' : '上传成功')}}</text><button wx:if="{{item.status === 'failed'}}" data-id="{{item.id}}" bindtap="retryUpload">重试</button><button data-id="{{item.id}}" data-type="image" bindtap="deleteEvidence">删除</button></view><button wx:if="{{(question.evidence.imageMaxCount || 4) - images.length > 0}}" class="evidence-add" bindtap="chooseImage">拍照或相册（最多 {{question.evidence.imageMaxCount || 4}} 张）</button></view></view><view wx:if="{{question.evidence.audioRequired}}" class="card"><text class="field__label">问题音频 <text class="required">必填</text></text><view class="evidence-list"><view wx:for="{{audios}}" wx:key="id" class="evidence-ready"><text>{{item.progressLabel || (item.status === 'active' ? '已保存音频' : '上传成功')}}</text><button wx:if="{{item.status === 'failed'}}" data-id="{{item.id}}" bindtap="retryUpload">重试</button><button data-id="{{item.id}}" bindtap="play">播放</button><button data-id="{{item.id}}" data-type="audio" bindtap="deleteEvidence">删除</button></view><button class="evidence-add" bindtap="toggleRecord">{{recording ? '停止录制' : '录制音频（最长 ' + (question.evidence.audioMaxDurationSeconds || 10) + ' 秒）'}}</button></view></view></block><view class="sticky-actions"><button class="secondary" bindtap="cancel">取消</button><button class="primary" loading="{{saving}}" disabled="{{saving}}" bindtap="save">确认</button></view></view>
