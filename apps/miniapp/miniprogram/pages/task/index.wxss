.task-page { padding-left: 32rpx; padding-right: 32rpx; }
.task-detail { padding-bottom: calc(240rpx + env(safe-area-inset-bottom)); }

/* 任务头 */
.task-hero { padding: 32rpx; margin-bottom: 18rpx; }
.task-hero-top { display: flex; align-items: center; gap: 14rpx; margin-bottom: 18rpx; }
.task-type { font-size: 24rpx; color: #70747b; }
.task-store { display: block; font-size: 36rpx; font-weight: 700; color: #26272a; line-height: 1.4; }
.task-address { display: block; margin-top: 10rpx; font-size: 26rpx; color: #70747b; line-height: 1.5; }
.task-window { display: block; margin-top: 10rpx; font-size: 26rpx; color: #26272a; line-height: 1.5; }

/* 信息块 */
.task-block { padding: 28rpx 32rpx; margin-bottom: 18rpx; }
.task-block-title { display: block; margin-bottom: 16rpx; font-size: 32rpx; font-weight: 700; color: #26272a; }
.task-block .muted { display: block; margin-top: 8rpx; }
.detail-row { min-height: 62rpx; display: flex; justify-content: space-between; align-items: center; color: #70747b; font-size: 25rpx; }
.detail-row text:last-child { color: #26272a; text-align: right; padding-left: 24rpx; }
.dish-line { display: flex; justify-content: space-between; align-items: center; padding: 22rpx 0; border-top: 1rpx solid #e8e9eb; font-size: 26rpx; }
.dish-line:first-of-type { border-top: 0; }
.dish-line text:last-child { color: #f25f42; font-size: 24rpx; }
.task-note { margin-bottom: 18rpx; padding: 24rpx 28rpx; color: #b45309; background: #fdf1e3; border-radius: 12rpx; font-size: 24rpx; line-height: 1.6; }

/* 逾期警告区 */
.task-overdue { padding: 32rpx; margin-bottom: 18rpx; border: 2rpx solid #f2c4a3; }
.overdue-title { display: block; font-size: 32rpx; font-weight: 700; color: #b45309; }
.overdue-desc { display: block; margin-top: 10rpx; font-size: 26rpx; color: #70747b; line-height: 1.6; }
.task-overdue .btn-outline { margin-top: 28rpx; }

/* 已取消终态：展示管理员填写的取消原因 */
.task-cancelled { padding: 32rpx; margin-bottom: 18rpx; border: 2rpx solid #d9dce0; }
.cancelled-title { display: block; font-size: 32rpx; font-weight: 700; color: #70747b; }
.cancelled-reason { display: block; margin-top: 10rpx; font-size: 26rpx; color: #26272a; line-height: 1.6; }
.task-cancelled .btn-outline { margin-top: 28rpx; }

/* 开始流程（固定底部操作区） */
.start-actions {
  position: fixed;
  left: 0; right: 0; bottom: 0; z-index: 10;
  padding: 16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid #e8e9eb;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.location-line { display: block; color: #70747b; text-align: center; font-size: 24rpx; }
.location-failed { color: #c83e2b; }
.start-actions .primary, .start-actions .secondary { width: 100%; }
.start-actions .primary[disabled] { background: #f2a18f; color: #fff; }

/* 骨架 / 错误态 */
.skeleton-hero { padding: 32rpx; margin-bottom: 18rpx; }
.skeleton-card { padding: 32rpx; margin-bottom: 18rpx; }
.skeleton-line { width: 100%; height: 36rpx; margin-top: 16rpx; }
.skeleton-line.short { width: 46%; }
.skeleton-line.mid { width: 72%; }
.task-slow-hint { display: block; text-align: center; color: #70747b; font-size: 24rpx; }
.task-error { padding: 40rpx 32rpx; }
.task-error .empty-title { display: block; font-size: 32rpx; font-weight: 700; }
.task-error .inline-error { margin-top: 12rpx; }
.task-error .primary, .task-error .btn-outline { margin-top: 24rpx; }

.btn-outline {
  width: 100%;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff;
  border: 1rpx solid #f25f42;
  border-radius: 12rpx;
  color: #f25f42;
  font-size: 28rpx;
  font-weight: 600;
  box-sizing: border-box;
}
.btn-outline::after { border: none; }
