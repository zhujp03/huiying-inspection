page { min-height: 100%; background: #ffffff; }

.other-page { min-height: 100vh; color: #292929; background: #ffffff; }
.app-nav { position: sticky; top: 0; z-index: 20; background: rgba(255, 255, 255, .98); }
.app-nav__bar { position: relative; display: flex; align-items: center; justify-content: center; min-height: 88rpx; }
.app-nav__title { max-width: 360rpx; overflow: hidden; font-size: 36rpx; font-weight: 600; line-height: 1; text-overflow: ellipsis; white-space: nowrap; }
.app-nav__back { position: absolute; left: 18rpx; top: 50%; width: 76rpx; height: 72rpx; padding: 0; transform: translateY(-50%); color: #222222; background: transparent; font-family: Arial, sans-serif; font-size: 68rpx; font-weight: 300; line-height: 64rpx; }
.app-nav__back[disabled] { color: #999999; background: transparent; }

.state-panel { margin: 48rpx 30rpx; padding: 48rpx 30rpx; border-radius: 18rpx; background: #f6f6f6; text-align: center; }
.other-content { min-height: calc(100vh - 176rpx); padding: 30rpx 24rpx calc(28rpx + env(safe-area-inset-bottom)); box-sizing: border-box; }
.record-field { display: block; scroll-margin-top: 180rpx; }
.record-field--suggestion { margin-top: 30rpx; }
.record-label { display: block; margin-bottom: 16rpx; color: #2b2b2b; font-size: 34rpx; font-weight: 500; line-height: 1.3; }
.required { padding-right: 4rpx; color: #ff6848; }
.record-textarea { width: 100%; min-height: 270rpx; padding: 24rpx; border: 0; border-radius: 16rpx; background: #f5f5f5; box-sizing: border-box; color: #2e2e2e; font-size: 28rpx; line-height: 1.55; }
.record-textarea--error { box-shadow: 0 0 0 2rpx #d84932 inset; }
.field-error { display: block; margin-top: 10rpx; color: #c83e29; font-size: 23rpx; line-height: 1.4; }
.submit-message { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; margin-top: 24rpx; padding: 18rpx 20rpx; border-radius: 12rpx; color: #6b594f; background: #fff3ee; font-size: 23rpx; line-height: 1.45; }
.submit-message--error { color: #b63723; background: #fff0ed; }
.retry-button { flex: none; width: auto; height: 62rpx; margin: 0; padding: 0 20rpx; color: #d94e34; background: #ffffff; font-size: 22rpx; line-height: 62rpx; }
.other-actions { position: sticky; bottom: 0; z-index: 10; display: grid; grid-template-columns: 1.1fr 1fr; gap: 24rpx; margin: 34rpx -24rpx -28rpx; padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom)); background: rgba(255, 255, 255, .98); }
.primary-action,
.secondary-action { height: 88rpx; border-radius: 10rpx; font-size: 30rpx; font-weight: 500; line-height: 88rpx; }
.primary-action { color: #ffffff; background: #ff6848; }
.secondary-action { color: #e75b40; background: #eeeeee; }
.primary-action[disabled],
.secondary-action[disabled] { opacity: .62; }
.other-content--keyboard .other-actions { padding-bottom: 18rpx; }

.success-page { min-height: 100vh; padding: calc(100rpx + env(safe-area-inset-top)) 54rpx calc(64rpx + env(safe-area-inset-bottom)); display: flex; flex-direction: column; align-items: center; justify-content: center; box-sizing: border-box; background: #ffffff; text-align: center; }
.success-mark { display: flex; align-items: center; justify-content: center; width: 132rpx; height: 132rpx; margin-bottom: 34rpx; border-radius: 50%; color: #ffffff; background: #ff6848; font-size: 64rpx; line-height: 1; }
.success-title { font-size: 40rpx; font-weight: 700; }
.success-time { margin-top: 22rpx; color: #777777; font-size: 24rpx; }
.success-copy { max-width: 560rpx; margin-top: 22rpx; color: #777777; font-size: 25rpx; line-height: 1.65; }
.success-action { width: 360rpx; margin-top: 52rpx; }

/* 提交确认弹窗（自定义 WXML，非 wx.showModal） */
.confirm-mask { position: fixed; inset: 0; z-index: 90; display: flex; align-items: center; justify-content: center; padding: 48rpx; background: rgba(20, 21, 24, .55); }
.confirm-panel { display: flex; flex-direction: column; gap: 18rpx; width: 100%; max-width: 560rpx; padding: 40rpx 32rpx 32rpx; border-radius: 20rpx; background: #ffffff; box-sizing: border-box; }
.confirm-title { color: #26272a; font-size: 34rpx; font-weight: 700; text-align: center; }
.confirm-score { color: #f25f42; font-size: 32rpx; font-weight: 700; text-align: center; }
.confirm-copy { color: #5a5d63; font-size: 26rpx; line-height: 1.6; text-align: center; }
.confirm-actions { display: grid; grid-template-columns: 1fr 1.4fr; gap: 20rpx; margin-top: 10rpx; }
.confirm-cancel { height: 84rpx; border-radius: 10rpx; color: #e75b40; background: #eeeeee; font-size: 29rpx; line-height: 84rpx; }
.confirm-primary { height: 84rpx; border-radius: 10rpx; color: #ffffff; background: #ff6848; font-size: 29rpx; font-weight: 500; line-height: 84rpx; }
.confirm-cancel[disabled],
.confirm-primary[disabled] { opacity: .62; }
.confirm-retry { width: auto; height: 62rpx; margin: 0; padding: 0 24rpx; color: #e75b40; background: #ffffff; font-size: 24rpx; line-height: 62rpx; }
