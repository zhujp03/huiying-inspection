page { min-height: 100%; background: #ffffff; }

.dish-page { min-height: 100vh; color: #292929; background: #ffffff; }
.app-nav { position: sticky; top: 0; z-index: 20; background: rgba(255, 255, 255, .98); }
.app-nav__bar { position: relative; display: flex; align-items: center; justify-content: center; min-height: 88rpx; }
.app-nav__title { max-width: 360rpx; overflow: hidden; font-size: 36rpx; font-weight: 600; line-height: 1; text-overflow: ellipsis; white-space: nowrap; }
.app-nav__back { position: absolute; left: 18rpx; top: 50%; width: 76rpx; height: 72rpx; padding: 0; transform: translateY(-50%); color: #222222; background: transparent; font-family: Arial, sans-serif; font-size: 68rpx; font-weight: 300; line-height: 64rpx; }
.app-nav__back[disabled] { color: #999999; background: transparent; }

.state-panel { margin: 48rpx 30rpx; padding: 48rpx 30rpx; border-radius: 18rpx; background: #f6f6f6; text-align: center; }
.state-retry { width: 240rpx; height: 76rpx; margin-top: 28rpx; color: #ffffff; background: #f26445; font-size: 26rpx; line-height: 76rpx; }
.dish-content { padding: 30rpx 26rpx calc(40rpx + env(safe-area-inset-bottom)); }
.dish-list { display: flex; flex-direction: column; gap: 42rpx; margin-top: 44rpx; }
.dish-block { scroll-margin-top: 180rpx; }
.dish-block--error .dish-evaluation,
.dish-block--error .conditional-input { box-shadow: 0 0 0 2rpx #e45136 inset; }
.dish-block--error .amount-grid input { box-shadow: 0 0 0 2rpx #e45136 inset; }

.receipt-section { padding: 26rpx; border-radius: 22rpx; background: #faf8f6; }
.section-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 20rpx; }
.section-heading > view:first-child { display: flex; flex-direction: column; gap: 8rpx; }
.section-title { color: #292929; font-size: 31rpx; font-weight: 650; }
.section-caption, .receipt-count { color: #88817d; font-size: 21rpx; line-height: 1.45; }
.receipt-count { flex: none; padding: 8rpx 12rpx; border-radius: 999rpx; background: #ffffff; }
.receipt-notice { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-top: 18rpx; padding: 16rpx; border-radius: 12rpx; color: #756f6b; background: #ffffff; font-size: 22rpx; }
.receipt-notice--error { color: #aa3c2c; background: #fff0ed; }
.receipt-notice button, .receipt-failure button, .ocr-error button { width: auto; min-width: 100rpx; height: 52rpx; margin: 0; padding: 0 14rpx; border-radius: 8rpx; color: #d94830; background: #ffffff; font-size: 21rpx; line-height: 52rpx; }
.receipt-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16rpx; margin-top: 22rpx; }
.receipt-tile, .receipt-add { position: relative; min-width: 0; height: 190rpx; overflow: hidden; border-radius: 14rpx; background: #ece9e6; }
.receipt-preview { width: 100%; height: 100%; padding: 0; border-radius: 0; background: transparent; }
.receipt-preview image { width: 100%; height: 100%; }
.receipt-placeholder { display: flex; align-items: center; justify-content: center; width: 100%; height: 100%; color: #817b77; font-size: 22rpx; }
.receipt-state { position: absolute; right: 0; bottom: 0; left: 0; display: flex; justify-content: space-between; gap: 6rpx; padding: 10rpx 12rpx; color: #ffffff; background: rgba(31, 28, 26, .72); font-size: 19rpx; }
.receipt-delete { position: absolute; top: 6rpx; right: 6rpx; width: 44rpx; height: 44rpx; margin: 0; padding: 0; border-radius: 50%; color: #ffffff; background: rgba(24, 22, 20, .72); font-size: 32rpx; line-height: 40rpx; }
.receipt-retry { position: absolute; left: 50%; bottom: 48rpx; width: auto; height: 52rpx; margin: 0; padding: 0 16rpx; transform: translateX(-50%); border-radius: 8rpx; color: #ffffff; background: #ff6848; font-size: 20rpx; line-height: 52rpx; white-space: nowrap; }
.receipt-progress { position: absolute; right: 0; bottom: 0; left: 0; height: 6rpx; background: rgba(255,255,255,.35); }
.receipt-progress view { height: 100%; background: #ff6848; }
.receipt-failure { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 10rpx; padding: 20rpx; color: #ffffff; background: rgba(70, 35, 29, .82); font-size: 19rpx; line-height: 1.35; text-align: center; }
.receipt-add { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8rpx; border: 2rpx dashed #d9cfc9; color: #8a817c; background: #ffffff; }
.receipt-add text { color: #ff6848; font-size: 54rpx; font-weight: 300; line-height: 1; }
.receipt-add__label { font-size: 21rpx; }
.ocr-panel { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-top: 22rpx; padding: 18rpx; border-radius: 14rpx; background: #ffffff; }
.ocr-panel > view { display: flex; min-width: 0; flex-direction: column; gap: 6rpx; }
.ocr-title { color: #393532; font-size: 25rpx; font-weight: 650; }
.ocr-status { color: #827c78; font-size: 21rpx; line-height: 1.4; }
.ocr-panel--success .ocr-status { color: #287857; }
.ocr-panel--review .ocr-status { color: #a76712; }
.ocr-panel--failed .ocr-status { color: #b33c2b; }
.ocr-action { flex: none; width: auto; min-width: 190rpx; height: 66rpx; margin: 0; padding: 0 20rpx; border-radius: 10rpx; color: #ffffff; background: #ff6848; font-size: 22rpx; line-height: 66rpx; }
.ocr-action[disabled] { color: #99918c; background: #eee9e6; }
.ocr-error { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-top: 12rpx; color: #a63a29; font-size: 21rpx; line-height: 1.45; }

.dish-primary-row { display: grid; grid-template-columns: 132rpx minmax(0, 1fr) 92rpx; gap: 16rpx; align-items: start; }
.dish-order { padding-top: 22rpx; color: #303030; font-size: 31rpx; font-weight: 600; white-space: nowrap; }
.dish-main { min-width: 0; }
.dish-name-input { width: 100%; height: 82rpx; padding: 0 22rpx; border: 0; border-radius: 12rpx; background: #f5f5f5; box-sizing: border-box; color: #292929; font-size: 30rpx; line-height: 82rpx; }
.dish-name-input--disabled { overflow: hidden; color: #8a8a8a; font-size: 25rpx; text-overflow: ellipsis; white-space: nowrap; }
.dish-meta-row { display: flex; align-items: center; gap: 16rpx; margin-top: 14rpx; min-height: 44rpx; }
.dish-status { min-width: 76rpx; padding: 8rpx 14rpx; border-radius: 8rpx; color: #5d5d5d; background: #eeeeee; font-size: 22rpx; line-height: 1.2; text-align: center; }
.dish-status__arrow { padding-left: 6rpx; color: #8a8a8a; }
.dish-requirement { overflow: hidden; color: #8a8a8a; font-size: 22rpx; text-overflow: ellipsis; white-space: nowrap; }
.satisfaction { width: 92rpx; min-height: 104rpx; margin: 0; padding: 4rpx 0 0; border-radius: 12rpx; color: #777777; background: transparent; font-size: 20rpx; line-height: 1.15; }
.satisfaction__face { display: block; width: 70rpx; height: 70rpx; margin: 0 auto 4rpx; border-radius: 50%; color: #ffffff; background: #9a9a9a; font-family: Arial, sans-serif; font-size: 52rpx; font-weight: 400; line-height: 66rpx; }
.satisfaction--active { color: #e45136; }
.satisfaction--active .satisfaction__face { background: #ff6848; }
.satisfaction__label { display: block; white-space: nowrap; }

.planned-row { margin: 14rpx 0 0 148rpx; color: #7b6259; font-size: 22rpx; line-height: 1.55; }
.planned-note { display: block; margin-top: 4rpx; color: #8b8b8b; }
.business-tags { display: flex; flex-wrap: wrap; gap: 8rpx; margin: 14rpx 0 0 148rpx; }
.business-tag { padding: 6rpx 10rpx; border-radius: 7rpx; color: #6d6763; background: #f0ece9; font-size: 19rpx; }
.business-tag--receipt { color: #c9472f; background: #fff0ec; }
.business-tag--review { color: #95600c; background: #fff4d9; }
.conditional-field { display: block; margin: 18rpx 0 0 148rpx; }
.conditional-field__label { display: block; margin-bottom: 10rpx; font-size: 24rpx; font-weight: 600; }
.required { color: #f26445; }
.conditional-input { width: 100%; min-height: 96rpx; padding: 20rpx 22rpx; border: 0; border-radius: 12rpx; background: #f5f5f5; box-sizing: border-box; color: #292929; font-size: 26rpx; line-height: 1.55; }
.dish-evaluation { width: 100%; min-height: 250rpx; margin-top: 18rpx; padding: 24rpx; border: 0; border-radius: 16rpx; background: #f5f5f5; box-sizing: border-box; color: #292929; font-size: 28rpx; line-height: 1.55; }
.amount-grid { display: grid; grid-template-columns: .65fr 1fr 1fr; gap: 12rpx; margin: 18rpx 0 0 148rpx; }
.amount-grid label { min-width: 0; }
.amount-grid label > text { display: block; margin-bottom: 8rpx; color: #77716d; font-size: 20rpx; }
.amount-grid input { width: 100%; height: 70rpx; padding: 0 14rpx; border-radius: 10rpx; background: #f5f5f5; box-sizing: border-box; font-size: 24rpx; line-height: 70rpx; }
.dish-error { margin: 12rpx 0 0 148rpx; color: #c83e29; font-size: 22rpx; line-height: 1.45; }

/* 折叠摘要行：数量单价已齐备（多为小票带入）的菜品收起金额与评价区 */
.dish-fold { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; width: 100%; margin: 18rpx 0 0 148rpx; padding: 18rpx 20rpx; border: 0; border-radius: 12rpx; background: #f6f7f8; color: #5a5d63; font-size: 24rpx; line-height: 1.5; text-align: left; }
.dish-fold__summary { flex: 1; min-width: 0; }
.dish-fold__action { flex: none; color: #f25f42; font-weight: 600; }
.delete-dish { width: auto; height: 58rpx; margin: 14rpx 0 0 auto; padding: 0 18rpx; color: #c54b37; background: #fff1ee; font-size: 22rpx; line-height: 58rpx; }

.add-dish { display: flex; align-items: center; justify-content: flex-start; width: 100%; min-height: 104rpx; margin-top: 36rpx; padding: 0; color: #8d8d8d; background: transparent; font-size: 30rpx; font-weight: 500; text-align: left; }
.add-dish__icon { display: inline-flex; align-items: center; justify-content: center; width: 76rpx; height: 76rpx; margin-right: 18rpx; border-radius: 50%; color: #ffffff; background: #ff6848; font-size: 56rpx; font-weight: 400; line-height: 1; }
.page-error { margin-top: 18rpx; padding: 18rpx 20rpx; border-radius: 10rpx; color: #b63723; background: #fff0ed; font-size: 24rpx; line-height: 1.5; }
.page-actions { position: sticky; bottom: 0; z-index: 10; display: grid; grid-template-columns: 1fr 1.45fr; gap: 18rpx; margin: 26rpx -26rpx -40rpx; padding: 18rpx 26rpx calc(18rpx + env(safe-area-inset-bottom)); background: rgba(255, 255, 255, .98); }
.primary-action,
.secondary-action { height: 88rpx; border-radius: 10rpx; font-size: 29rpx; font-weight: 600; line-height: 88rpx; }
.primary-action { color: #ffffff; background: #ff6848; }
.secondary-action { color: #6d6d6d; background: #ededed; }
.primary-action[disabled],
.secondary-action[disabled] { opacity: .62; }

@media (max-width: 360px) {
  .dish-primary-row { grid-template-columns: 118rpx minmax(0, 1fr) 82rpx; gap: 10rpx; }
  .dish-order { font-size: 27rpx; }
  .planned-row, .conditional-field, .business-tags, .amount-grid, .dish-error, .dish-fold { margin-left: 128rpx; }
  .amount-grid { grid-template-columns: 1fr 1fr; }
  .amount-grid label:first-child { grid-column: 1 / -1; }
  .ocr-panel { align-items: stretch; flex-direction: column; }
  .ocr-action { width: 100%; }
}

/* 闪光点编辑器（第二步 其他照片） */
.highlight-section { margin: 20rpx 24rpx 0; padding: 24rpx; border-radius: 16rpx; background: #ffffff; }
.highlight-item { padding: 20rpx 0; border-bottom: 1rpx solid #eceef0; }
.highlight-item:last-child { border-bottom: none; }
.highlight-item__head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12rpx; color: #5a5d63; font-size: 24rpx; }
.highlight-remove { flex: none; width: auto; height: 52rpx; margin: 0; padding: 0 16rpx; color: #e45136; background: transparent; font-size: 22rpx; line-height: 52rpx; }
.highlight-textarea { width: 100%; min-height: 140rpx; padding: 20rpx; border: 0; border-radius: 12rpx; background: #f5f5f5; box-sizing: border-box; color: #2e2e2e; font-size: 26rpx; line-height: 1.55; }
.highlight-photos { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12rpx; margin-top: 14rpx; }
.highlight-tile-wrap { position: relative; }
.highlight-tile { width: 100%; aspect-ratio: 1; margin: 0; padding: 0; border-radius: 10rpx; overflow: hidden; background: #f2f3f5; }
.highlight-tile image { width: 100%; height: 100%; }
.highlight-placeholder { display: flex; align-items: center; justify-content: center; height: 100%; color: #b7bac0; font-size: 20rpx; }
.highlight-tile__remove { position: absolute; top: 6rpx; right: 6rpx; width: 40rpx; height: 40rpx; margin: 0; padding: 0; border-radius: 50%; background: rgba(20, 21, 24, .6); color: #ffffff; font-size: 24rpx; line-height: 40rpx; }
.highlight-progress { position: absolute; left: 0; right: 0; bottom: 0; height: 6rpx; background: #e8e9eb; }
.highlight-progress view { height: 100%; background: #f25f42; }
.highlight-failure { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 6rpx; padding: 8rpx; border-radius: 10rpx; background: rgba(20, 21, 24, .6); }
.highlight-failure text { color: #ffffff; font-size: 18rpx; text-align: center; }
.highlight-failure button { width: auto; height: 44rpx; margin: 0; padding: 0 14rpx; color: #ffffff; background: transparent; font-size: 20rpx; line-height: 44rpx; }
.highlight-add-photo { aspect-ratio: 1; margin: 0; padding: 0; border: 2rpx dashed #dedfe2; border-radius: 10rpx; background: #f7f7f7; color: #b7bac0; font-size: 36rpx; line-height: normal; }
.highlight-add { display: flex; align-items: center; justify-content: center; gap: 8rpx; width: 100%; height: 84rpx; margin-top: 16rpx; border: 2rpx dashed #dedfe2; border-radius: 12rpx; background: #f7f7f7; color: #5a5d63; font-size: 26rpx; line-height: 84rpx; }
.highlight-add__icon { font-size: 32rpx; }
