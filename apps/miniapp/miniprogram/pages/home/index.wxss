.home-page { padding-left: 32rpx; padding-right: 32rpx; }
.home-hero {
  height: 180rpx;
  margin-bottom: 24rpx;
  padding: 40rpx 32rpx;
  box-sizing: border-box;
  border-radius: 20rpx;
  background: #26272a;
  color: #fff;
  display: flex;
  flex-direction: column;
  justify-content: center;
}
.home-hero-title { font-size: 40rpx; font-weight: 700; }
.home-hero-sub { margin-top: 8rpx; font-size: 24rpx; color: #c8c9cc; }

/* 任务卡 */
.home-task-card { padding: 32rpx; margin-bottom: 18rpx; display: flex; flex-direction: column; }
.home-task-meta { display: flex; align-items: center; gap: 14rpx; margin-bottom: 18rpx; }
.home-task-type { font-size: 24rpx; color: #70747b; }
.home-task-store { font-size: 34rpx; font-weight: 700; color: #26272a; line-height: 1.4; }
.home-task-name { margin-top: 8rpx; font-size: 26rpx; color: #70747b; line-height: 1.5; }
.home-task-time { margin-top: 12rpx; font-size: 26rpx; color: #26272a; line-height: 1.5; }
.home-task-progress { margin-top: 10rpx; font-size: 25rpx; color: #f25f42; line-height: 1.5; }
.home-task-btn { margin-top: 28rpx; }

/* 骨架（与任务卡同形状，纯色块） */
.skeleton-tag { width: 120rpx; height: 36rpx; margin-bottom: 20rpx; }
.skeleton-line { width: 100%; height: 40rpx; margin-top: 16rpx; }
.skeleton-line.short { width: 46%; }
.skeleton-line.mid { width: 70%; }
.skeleton-btn { width: 100%; height: 88rpx; margin-top: 32rpx; }

/* 错误 / 空态 */
.home-task-card .empty-title { display: block; font-size: 32rpx; font-weight: 700; color: #26272a; }
.home-task-card .inline-error { margin-top: 12rpx; }
.home-task-card .btn-outline, .home-task-card .primary { margin-top: 28rpx; }
.btn-outline {
  width: 100%;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff;
  border: 1rpx solid #f25f42;
  border-radius: 12rpx;
  color: #f25f42;
  font-size: 28rpx;
  font-weight: 600;
  box-sizing: border-box;
}
.btn-outline::after { border: none; }

.home-error-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 18rpx;
  padding: 16rpx 24rpx;
  background: #fdf1e3;
  border-radius: 12rpx;
}
.home-error-bar .inline-error { color: #b45309; }
.home-error-retry { color: #f25f42; font-size: 26rpx; }

/* 执行提醒 */
.home-remind { padding: 24rpx 32rpx; margin-bottom: 18rpx; }
.remind-line { display: block; padding: 8rpx 0; font-size: 26rpx; color: #26272a; line-height: 1.5; }

/* 只读统计（紧凑三格） */
.home-stats {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 16rpx;
}
.stat {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 8rpx;
  background: #fff;
  border-radius: 20rpx;
}
.stat-num { font-size: 36rpx; font-weight: 700; color: #26272a; }
.stat-label { margin-top: 4rpx; font-size: 23rpx; color: #70747b; }
