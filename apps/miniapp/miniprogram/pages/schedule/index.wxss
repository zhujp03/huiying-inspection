.schedule-page { padding-left: 32rpx; padding-right: 32rpx; }
.schedule-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 24rpx;
  padding: 8rpx 4rpx 0;
}
.schedule-title { font-size: 40rpx; font-weight: 700; color: #26272a; }
.schedule-count { font-size: 24rpx; color: #70747b; }

/* 状态筛选 chips：横向滚动、不换行，承接原问卷入口页的分段视图 */
.schedule-filter { display: flex; flex-wrap: nowrap; gap: 14rpx; margin-bottom: 20rpx; white-space: nowrap; }
.schedule-chip {
  flex: none;
  height: 56rpx;
  margin: 0;
  padding: 0 26rpx;
  border: 1rpx solid #e6e7ea;
  border-radius: 999rpx;
  color: #5a5d63;
  background: #ffffff;
  font-size: 24rpx;
  line-height: 54rpx;
}
.schedule-chip--active { color: #ffffff; background: #f25f42; border-color: #f25f42; font-weight: 600; }
.schedule-filter-reset { width: auto; height: 60rpx; margin: 20rpx 0 0; padding: 0 30rpx; color: #f25f42; background: #ffffff; border: 1rpx solid #f25f42; border-radius: 999rpx; font-size: 25rpx; line-height: 58rpx; }

/* 日期分组：日期标题单独一行，与卡片 16rpx 间距 */
.schedule-group { margin-bottom: 8rpx; }
.schedule-date { display: block; margin: 24rpx 4rpx 16rpx; font-size: 28rpx; font-weight: 700; color: #26272a; }

/* 任务卡 */
.task-card {
  width: 100%;
  padding: 28rpx 32rpx;
  margin-bottom: 16rpx;
  box-sizing: border-box;
}
.task-card-top { display: flex; align-items: center; gap: 14rpx; margin-bottom: 16rpx; }
.task-type { font-size: 24rpx; color: #70747b; }
.task-store { display: block; font-size: 32rpx; font-weight: 700; color: #26272a; line-height: 1.4; }
.task-name { display: block; margin-top: 6rpx; font-size: 25rpx; color: #70747b; line-height: 1.5; }
.task-time { display: flex; flex-wrap: wrap; gap: 8rpx 16rpx; margin-top: 14rpx; font-size: 25rpx; color: #26272a; line-height: 1.5; }
.task-due { color: #b45309; }
.task-card-foot {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #e8e9eb;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.task-action { font-size: 26rpx; color: #f25f42; font-weight: 600; }

/* 骨架 */
.skeleton-date { width: 180rpx; height: 40rpx; margin: 24rpx 4rpx 16rpx; }
.skeleton-card { min-height: 220rpx; }
.skeleton-line { width: 100%; height: 36rpx; margin-top: 16rpx; }
.skeleton-line.short { width: 46%; }
.skeleton-line.mid { width: 72%; }

/* 错误态 / 非阻塞错误条 */
.schedule-error { padding: 40rpx 32rpx; }
.schedule-error .empty-title { display: block; font-size: 32rpx; font-weight: 700; }
.schedule-error .inline-error { margin-top: 12rpx; }
.schedule-error .primary { margin-top: 28rpx; }
.schedule-error-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 18rpx;
  padding: 16rpx 24rpx;
  background: #fdf1e3;
  border-radius: 12rpx;
}
.schedule-error-bar .inline-error { color: #b45309; }
.schedule-error-retry { color: #f25f42; font-size: 26rpx; }
